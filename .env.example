# Токен парсера 1688 (bhapi.ru). Читается только на сервере, в браузер не попадает.
BHAPI_TOKEN=

# База API — менять обычно не нужно
BHAPI_BASE=https://bhapi.ru/1688/api/v1

# Открыть /api/debug в продакшене (сырые ответы парсера для сверки схемы)
# ENABLE_DEBUG=1

# Базовый URL открытого каталога (по умолчанию https://dummyjson.com)
# CATALOG_BASE=

# Базы Wildberries — переопределяются для зеркал и локальных стендов
# WB_SEARCH_BASE=
# WB_BASKET_BASE=

# Дополнительные хосты картинок через запятую (локальные зеркала, стенды)
# IMG_EXTRA_HOSTS=

# AliExpress: ключи из партнёрского кабинета portals.aliexpress.com
# ALI_APP_KEY=
# ALI_APP_SECRET=
# ALI_TRACKING_ID=
# ALI_LANG=RU
# ALI_CURRENCY=RUB
# ALI_SHIP_TO=RU

# Учётные записи. Без этих переменных используется файл .data/auth.json —
# он годится для локального запуска, но НЕ для Vercel: там файловая система
# эфемерная и регистрации будут пропадать. Подойдёт любой Redis с REST-шлюзом
# (например, Upstash — у него есть бесплатный тариф).
# AUTH_REDIS_URL=
# AUTH_REDIS_TOKEN=
# Проверить настройку: GET /api/auth/health — он скажет, отвечает ли база
# и что именно чинить, не раскрывая ни адреса, ни токена.

# Письма: подтверждение почты и восстановление пароля. Без RESEND_API_KEY
# регистрация работает, но письма не уходят — восстановить пароль будет нечем.
# Ключ берётся в Resend (есть бесплатный тариф). MAIL_FROM должен быть на
# домене, подтверждённом у провайдера; без него письма уходят с адреса
# песочницы и доходят только на почту владельца ключа.
# RESEND_API_KEY=
# MAIL_FROM=Swiper <no-reply@ваш-домен.ru>
# Адрес приложения для ссылок в письмах. На Vercel определяется сам,
# задавать нужно только при своём домене или запуске за прокси.
# APP_URL=https://ваш-домен.ru

# Каталог из Etsy. Приложение в API не ходит вообще: импортёр складывает
# снапшот на диск, а лента и карточки читают только его — ни один свайп не
# стоит ни одного запроса.
#   npm run catalog:etsy -- --check          проверить ключ, 1 запрос
#   npm run catalog:etsy                     импорт в пределах дневного бюджета
# ETSY_API_KEY=
# Etsy требует в x-api-key пару «keystring:shared_secret» — секрет обязателен.
# ETSY_SHARED_SECRET=
# Ниже дневного лимита Etsy — про запас. Пара «поиск + картинки» стоит два
# запроса и приносит до 100 карточек.
# ETSY_DAILY_BUDGET=4000

# Где лежит снапшот каталога. Если не задан, берётся из AUTH_FILE (тот же
# каталог с данными), иначе — файл из репозитория.
# CATALOG_FILE=/var/lib/swiper/catalog.json

# Картинки каталога, скачанные на свой сервер (npm run catalog:images).
# По умолчанию — папка images рядом со снапшотом.
# IMAGE_DIR=/var/lib/swiper/images

# Фотографии, которые люди прикладывают к своим желаниям в вишлисте.
# По умолчанию — папка uploads рядом с файлом учётных записей (AUTH_FILE),
# иначе .data/uploads. Каталог должен быть доступен приложению на запись.
# UPLOAD_DIR=/var/lib/swiper/uploads

# Потолок каталога. Импортёр перестаёт добирать новые карточки, дойдя до него,
# но продолжает обновлять цены у известных. Упор здесь не в запросы к Etsy, а
# в место под фотографии: карточка с тремя снимками весит около 150 КБ.
# CATALOG_MAX=60000

# Сколько снимков карточки переносить к себе (npm run catalog:images).
# Остальные остаются на CDN магазина: их видно редко, а место они занимают.
# IMAGE_PER_CARD=3

# Курс валют приложение берёт само у Центробанка: сначала JSON-зеркало, при
# его недоступности — официальный XML с cbr.ru. Переопределять нужно разве что
# для проверки или если появится свой источник.
# RATES_URL=https://www.cbr-xml-daily.ru/daily_json.js
# RATES_URL_XML=https://www.cbr.ru/scripts/XML_daily.asp
# Последний полученный курс лежит рядом с остальными данными и переживает
# перезапуск: без него первые секунды после рестарта цены считались бы по
# запасному курсу из кода.
# RATES_FILE=/var/lib/swiper/rates.json
